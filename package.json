{
  "name": "ncc",
  "version": "22.0.0",
  "description": "Packages used by Angular",
  "scripts": {
    "ng": "ng",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'),dir='node_modules/moment/locale';fs.readdirSync(dir).forEach(f=>{if(f!=='vi.js')fs.unlinkSync(path.join(dir,f))});console.log('moment locales cleaned');\"",
    "start": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --port 3105",
    "build": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=production",
    "build-test": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=test",
    "build-prod": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod",
    "build-kg": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod_KG",
    "build-sotbvl": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod_SOTBVL",
    "verify:dev": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=dev --output-path build/_verify_dev",
    "verify:prod": "yarn -s postinstall && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod --output-path build/_verify_prod",
    "test": "ng test",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fortawesome/fontawesome-free": "^5.11.2",
    "@kolkov/angular-editor": "3.4.0",
