{
  "name": "ncc",
  "version": "13.0.0",
  "description": "Packages used by Angular",
  "scripts": {
    "ng": "ng",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'),dir='node_modules/moment/locale';fs.readdirSync(dir).forEach(f=>{if(f!=='vi.js')fs.unlinkSync(path.join(dir,f))});console.log('moment locales cleaned');\"",
    "start": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --port 3105",
    "build": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --prod",
    "build-test": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=test",
    "build-prod": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod",
    "build-kg": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod_KG",
    "build-sotbvl": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod_SOTBVL",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json",
    "rtl": "webpack"
  },
