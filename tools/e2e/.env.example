# Chep thanh .env (khong commit). Xem README.md.
E2E_BASE_URL=http://localhost:3105
E2E_USER=
E2E_PASS=
# Chi dat 1 khi backend dang tro vao database ban sao.
E2E_ALLOW_WRITE=0
# Lenh khoi phuc database ban sao ve trang thai chuan, chay truoc moi luot @rw.
E2E_RESTORE_CMD=
# Neu ban build goi API o dia chi khac voi backend dang chay tren may nay:
# moi request toi E2E_API_FROM duoc chuyen sang E2E_API_TO.
E2E_API_FROM=
E2E_API_TO=
